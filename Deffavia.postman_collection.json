{
  "info": {
    "name": "Deffavia API",
    "_postman_id": "f2f7c1f9-aaaa-bbbb-cccc-deffavia0001",
    "description": "Colección de pruebas para Deffavia",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3001" },
    { "key": "token", "value": "" },
    { "key": "userEmail", "value": "alumno@gmail.com" }
  ],
  "item": [
    {
      "name": "Health",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/health" }
    },
    {
      "name": "Users - Register",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/users",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Secret123\"\n}"
        }
      }
    },
    {
      "name": "Auth - Login",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"{{userEmail}}\",\n  \"password\": \"Secret123\"\n}"
        }
      }
    },
    {
      "name": "Admin - Seed seats",
      "request": { "method": "POST", "url": "{{baseUrl}}/api/admin/seed-seats" }
    },
    {
      "name": "Seats - List",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/seats" }
    },
    {
      "name": "Reservations - Create (manual)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userEmail\": \"{{userEmail}}\",\n  \"mode\": \"manual\",\n  \"selections\": [\n    { \"seatCode\": \"E5\", \"passengerName\": \"Juan Perez\", \"cui\": \"1234567890123\", \"hasLuggage\": true }\n  ]\n}"
        }
      }
    },
    {
      "name": "Reservations - Create (random)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/reservations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userEmail\": \"{{userEmail}}\",\n  \"mode\": \"random\",\n  \"random\": {\n    \"seatClass\": \"economy\",\n    \"count\": 1,\n    \"passengers\": [\n      { \"passengerName\": \"Ana Uno\", \"cui\": \"1234567890124\", \"hasLuggage\": false }\n    ]\n  }\n}"
        }
      }
    },
    {
      "name": "Reservations - My",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/reservations/my"
      }
    },
    {
      "name": "Reservations - Modify item (+10%)",
      "request": {
        "method": "PATCH",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/reservations/1/items/1/seat",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"newSeatCode\": \"F6\",\n  \"cui\": \"1234567890123\"\n}"
        },
        "description": "Actualiza orderId e itemId según respuesta de 'Reservations - My'"
      }
    },
    {
      "name": "Reservations - Cancel item",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/reservations/1/items/1/cancel",
        "body": { "mode": "raw", "raw": "{ \"cui\": \"1234567890123\" }" },
        "description": "Actualiza orderId e itemId según respuesta de 'Reservations - My'"
      }
    },
    {
      "name": "Reservations - Cancel order",
      "request": {
        "method": "POST",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/reservations/1/cancel",
        "description": "Actualiza orderId según respuesta de 'Reservations - My'"
      }
    },
    {
      "name": "Files - Export XML",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/files/export-xml" }
    },
    {
      "name": "Files - Import XML",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "multipart/form-data" }],
        "url": "{{baseUrl}}/api/files/import-xml"
      },
      "description": "Adjunta un archivo XML en 'file'."
    },
    {
      "name": "Reports - Summary",
      "request": { "method": "GET", "url": "{{baseUrl}}/api/reports/summary" }
    },
    {
      "name": "Mail - Send quote (test)",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/mail/send-quote",
        "body": { "mode": "raw", "raw": "{ \"toEmail\": \"{{userEmail}}\", \"html\": \"<p>Hola</p>\" }" }
      }
    }
  ]
}